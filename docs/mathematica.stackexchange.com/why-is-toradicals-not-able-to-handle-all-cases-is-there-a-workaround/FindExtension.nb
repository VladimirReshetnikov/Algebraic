        RowBox[{
         RowBox[{
          RowBox[{
          "poly", "\[LeftDoubleBracket]", "0", "\[RightDoubleBracket]"}], "===",
           "Root"}], ",", 
         RowBox[{"MinimalPolynomial", "[", 
          RowBox[{"poly", ",", "x"}], "]"}], ",", "poly"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"product", "=", 
