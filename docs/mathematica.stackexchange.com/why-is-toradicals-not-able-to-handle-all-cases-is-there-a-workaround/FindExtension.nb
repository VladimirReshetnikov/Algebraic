Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "fuzz", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fuzz", "[", "r_", "]"}], ":=", 
   RowBox[{"fuzz", "[", 
    RowBox[{"r", ",", 
     RowBox[{
      RowBox[{"Length", "[", 
       RowBox[{"roots", "[", "r", "]"}], "]"}], "-", "1"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fuzz", "[", 
    RowBox[{"r_", ",", "max_Integer"}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rs", "=", 
       RowBox[{"roots", "[", "r", "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"appx", ",", "x", ",", "s", ",", 
         RowBox[{"n", "=", "0"}], ",", "mp", ",", 
         RowBox[{"seen", "=", 
          RowBox[{"<|", "|>"}]}], ",", 
         RowBox[{"$MaxExtraPrecision", "=", "2000"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"PrintTemporary", "[", 
         RowBox[{"Dynamic", "[", "n", "]"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"While", "[", 
         RowBox[{"True", ",", "\[IndentingNewLine]", 
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"sam", "=", 
              RowBox[{"Sort", "[", 
               RowBox[{"RandomSample", "[", 
                RowBox[{"rs", ",", 
                 RowBox[{"RandomInteger", "[", 
                  RowBox[{"{", 
                   RowBox[{"2", ",", 
                    RowBox[{"Length", "[", "rs", "]"}]}], "}"}], "]"}]}], 
                "]"}], "]"}]}], "}"}], ",", 
            RowBox[{"(*", 
             RowBox[{"RandomInteger", "[", 
              RowBox[{"{", 
               RowBox[{"2", ",", 
                RowBox[{"Length", "[", "rs", "]"}]}], "}"}], "]"}], "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"\[Not]", 
               RowBox[{"KeyExistsQ", "[", 
                RowBox[{"seen", ",", "sam"}], "]"}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{
                RowBox[{"seen", "[", "sam", "]"}], "=", "True"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"s", "=", 
                RowBox[{"(", 
                 RowBox[{"Plus", "@@", "sam"}], ")"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"appx", "=", 
                RowBox[{"RootApproximant", "[", 
                 RowBox[{
                  RowBox[{"N", "[", 
                   RowBox[{"s", ",", "400"}], "]"}], ",", "max"}], "]"}]}], 
               ";", "\[IndentingNewLine]", 
               RowBox[{"mp", "=", 
                RowBox[{"MinimalPolynomial", "[", 
                 RowBox[{"appx", ",", "x"}], "]"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"\[Not]", 
                   RowBox[{"IntegerQ", "[", "appx", "]"}]}], "&&", 
                  RowBox[{"\[Not]", 
                   RowBox[{"KeyExistsQ", "[", 
                    RowBox[{"seen", ",", "mp"}], "]"}]}]}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"seen", "[", "mp", "]"}], "=", "True"}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"n", "++"}], ";", "\[IndentingNewLine]", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{"Quiet", "[", 
                    RowBox[{
                    RowBox[{"PossibleZeroQ", "[", 
                    RowBox[{"s", "-", "appx"}], "]"}], ",", 
                    RowBox[{"PossibleZeroQ", "::", "ztest1"}]}], "]"}], ",", 
                    RowBox[{"Print", "[", "appx", "]"}]}], "]"}]}]}], 
                "]"}]}]}], "]"}]}], "]"}]}], "]"}]}]}], "]"}]}], "]"}]}], 
  ";"}]}], "Input",
