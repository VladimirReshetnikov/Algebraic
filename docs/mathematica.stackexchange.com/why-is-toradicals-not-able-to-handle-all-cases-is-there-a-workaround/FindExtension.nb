           "=!=", "Times"}], ",", "\[IndentingNewLine]", "product", ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"List", "@@", "product"}], ",", 
             RowBox[{
              RowBox[{"PossibleZeroQ", "[", 
               RowBox[{"#", "/.", 
                RowBox[{"x", "\[Rule]", "root"}]}], "]"}], "&"}], ",", "1"}], 
