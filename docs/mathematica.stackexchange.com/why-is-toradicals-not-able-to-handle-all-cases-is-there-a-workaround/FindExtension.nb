Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "findExtension", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"findExtension", "[", "root_", "]"}], ":=", 
   RowBox[{
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"p", ",", "q", ",", "x"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"mp", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
             "root", "\[LeftDoubleBracket]", "0", "\[RightDoubleBracket]"}], "===",
              "Root"}], ",", 
            RowBox[{"MinimalPolynomial", "[", 
             RowBox[{"root", ",", "x"}], "]"}], ",", "root"}], "]"}]}], "}"}],
         ",", 
        RowBox[{"MinimalBy", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"DeleteCases", "[", 
           RowBox[{
            RowBox[{"p", "/.", 
             RowBox[{"Solve", "[", 
              RowBox[{
               RowBox[{"Exists", "[", 
                RowBox[{"q", ",", 
                 RowBox[{"LogicalExpand", "[", 
                  RowBox[{"\[Not]", 
                   RowBox[{"Eliminate", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"PolynomialRemainder", "[", 
                    RowBox[{"mp", ",", 
                    RowBox[{
                    SuperscriptBox["x", "2"], "+", 
                    RowBox[{"p", " ", "x"}], "+", "q"}], ",", "x"}], "]"}], 
                    "\[NotEqual]", "0"}], ",", "x"}], "]"}]}], "]"}]}], "]"}],
                ",", "p"}], "]"}]}], ",", 
            RowBox[{"_", "?", "ExactNumberQ"}]}], "]"}], ",", 
          "\[IndentingNewLine]", "Simplify`SimpifyCount", ",", "1"}], "]"}]}],
        "]"}]}], "]"}], "\[LeftDoubleBracket]", "1", 
    "\[RightDoubleBracket]"}]}], ";"}]}], "Input",
