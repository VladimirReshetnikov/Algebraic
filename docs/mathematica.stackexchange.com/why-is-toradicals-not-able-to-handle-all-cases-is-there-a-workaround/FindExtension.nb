Cell[BoxData[
 RowBox[{
  RowBox[{"ClearAll", "[", "findExtension3", "]"}], ";", 
  RowBox[{
   RowBox[{"findExtension3", "[", "root_", "]"}], ":=", 
   RowBox[{
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"p", ",", "q", ",", "r", ",", "x"}], "}"}], ",", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"mp", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
             "root", "\[LeftDoubleBracket]", "0", "\[RightDoubleBracket]"}], "===",
              "Root"}], ",", 
            RowBox[{"MinimalPolynomial", "[", 
             RowBox[{"root", ",", "x"}], "]"}], ",", "root"}], "]"}]}], "}"}],
         ",", 
        RowBox[{"MinimalBy", "[", 
         RowBox[{
          RowBox[{"DeleteCases", "[", 
           RowBox[{
            RowBox[{"p", "/.", "\[VeryThinSpace]", 
             RowBox[{"Solve", "[", 
              RowBox[{
               RowBox[{
                SubscriptBox["\[Exists]", 
                 RowBox[{"{", 
                  RowBox[{"q", ",", "r"}], "}"}]], 
                RowBox[{"LogicalExpand", "[", 
                 RowBox[{"\[Not]", 
                  RowBox[{"Eliminate", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"PolynomialRemainder", "[", 
                    RowBox[{"mp", ",", 
                    RowBox[{
                    SuperscriptBox["x", "3"], "+", 
                    RowBox[{"p", " ", 
                    SuperscriptBox["x", "2"]}], "+", 
                    RowBox[{"q", " ", "x"}], "+", "r"}], ",", "x"}], "]"}], 
                    "\[NotEqual]", "0"}], ",", "x"}], "]"}]}], "]"}]}], ",", 
               "p"}], "]"}]}], ",", 
            RowBox[{"_", "?", "ExactNumberQ"}]}], "]"}], ",", 
          "Simplify`SimpifyCount", ",", "1"}], "]"}]}], "]"}]}], "]"}], 
    "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}]}]], "Input",
