Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "radicalDepth", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"radicalDepth", "[", 
    RowBox[{"x_", "/;", 
     RowBox[{"FreeQ", "[", 
      RowBox[{"x", ",", 
       RowBox[{
        RowBox[{"_", "^", "_Rational"}], "|", "_Sin", "|", "_Cos"}]}], 
      "]"}]}], "]"}], "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"radicalDepth", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"radicalDepth", "[", "x", "]"}], "=", 
    RowBox[{"1", "+", 
     RowBox[{"Max", "[", 
      RowBox[{"radicalDepth", "/@", 
       RowBox[{"Union", "[", 
        RowBox[{
         RowBox[{"Cases", "[", 
          RowBox[{"x", ",", 
           RowBox[{
            SuperscriptBox["b_", "_Rational"], "\[RuleDelayed]", "b"}], ",", 
           "All"}], "]"}], ",", 
         RowBox[{"Cases", "[", 
          RowBox[{"x", ",", 
           RowBox[{
            RowBox[{"Sin", "[", "b_", "]"}], "\[RuleDelayed]", "b"}], ",", 
           "All"}], "]"}], ",", 
         RowBox[{"Cases", "[", 
          RowBox[{"x", ",", 
           RowBox[{
            RowBox[{"Cos", "[", "b_", "]"}], "\[RuleDelayed]", "b"}], ",", 
           "All"}], "]"}]}], "]"}]}], "]"}]}]}]}], ";"}]}], "Input",
