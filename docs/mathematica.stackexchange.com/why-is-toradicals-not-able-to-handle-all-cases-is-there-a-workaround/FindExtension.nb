Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "project", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"project", "[", "r_Root", "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", "e"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"e", "=", 
       RowBox[{"Exponent", "[", 
        RowBox[{
         RowBox[{"MinimalPolynomial", "[", 
          RowBox[{"r", ",", "x"}], "]"}], ",", "x"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Catch", "[", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"Block", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"re", ",", "im"}], "}"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"re", ",", "im"}], "}"}], "=", 
             RowBox[{"RootReduce", "[", 
              RowBox[{"ReIm", "[", 
               RowBox[{"Root", "[", 
                RowBox[{
                 RowBox[{
                 "r", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
                 ",", "n"}], "]"}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"\[Not]", 
                RowBox[{"ExactNumberQ", "[", "re", "]"}]}], "&&", 
               RowBox[{
                RowBox[{"Exponent", "[", 
                 RowBox[{
                  RowBox[{"MinimalPolynomial", "[", 
                   RowBox[{"re", ",", "x"}], "]"}], ",", "x"}], "]"}], "<", 
                "e"}]}], ",", 
              RowBox[{"Throw", "[", "re", "]"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"\[Not]", 
                RowBox[{"ExactNumberQ", "[", "im", "]"}]}], "&&", 
               RowBox[{
                RowBox[{"Exponent", "[", 
                 RowBox[{
                  RowBox[{"MinimalPolynomial", "[", 
                   RowBox[{"im", ",", "x"}], "]"}], ",", "x"}], "]"}], "<", 
                "e"}]}], ",", 
              RowBox[{"Throw", "[", "im", "]"}]}], "]"}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "e"}], "}"}]}], "]"}], "]"}]}]}], "]"}]}], 
  ";"}]}], "Input",
