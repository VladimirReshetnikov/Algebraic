VerificationTest[improves[(-239 - 169 Sqrt[2])^(1/7), (-1)^(1/7) (1 + Sqrt[2])], True, TestID -> "C-R8-negative-seventh"]
VerificationTest[improves[(1393 - 985 Sqrt[2])^(1/9), (-1)^(1/9) (Sqrt[2] - 1)], True, TestID -> "C-R8-negative-ninth"]
