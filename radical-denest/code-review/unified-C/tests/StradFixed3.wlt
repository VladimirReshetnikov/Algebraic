VerificationTest[RadicalDenest3`Private`bitSize[1 + I] > 0, True, TestID -> "C-R9-cost-gaussian-bits"]
VerificationTest[FailureQ /@ {RadicalDenest3`DenestCore[Sqrt[2], "MaxTrials" -> -1], RadicalDenest3`DenestReport[Sqrt[2], "MaxCosets" -> 5/2], RadicalDenest3`Strad[Sqrt[2], 123]}, {True, True, True}, TestID -> "C-R9-option-failures"]
VerificationTest[MissingQ[RadicalDenest3`DenestReport[Sqrt[2], "TimeBudget" -> 0]["InitialCost"]], True, TestID -> "C-R9-zero-budget-no-post-cost"]
