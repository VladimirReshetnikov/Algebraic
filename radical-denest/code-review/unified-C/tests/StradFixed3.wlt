VerificationTest[Module[{t = (3 + 2 Sqrt[2])^(1/6), r}, r = session[RadicalDenest3`Private`kummerCandidates[t, 3 + 2 Sqrt[2], 1, 6, t]]; {eq[r, t], RadicalDenest3`Private`cheaperQ[r, t]}], {True, True}, TestID -> "C-R8-raw-index-reduction-without-recursion"]
VerificationTest[memberEq[session[RadicalDenest3`Private`honsbeekSquareRoots[28^(1/3) - 3]], Sqrt[28^(1/3) - 3]], True, TestID -> "C-R8-honsbeek-rational-summand"]
VerificationTest[memberEq[session[RadicalDenest3`Private`honsbeekSquareRoots[5^(1/3) - 4^(1/3)]], Sqrt[5^(1/3) - 4^(1/3)]], True, TestID -> "C-R8-honsbeek-classical"]
VerificationTest[MemberQ[session[RadicalDenest3`Private`cosetBases[{55, 210, 462}, {2, 3, 5, 7, 11}]], {6, 35, 77, 330}], True, TestID -> "C-R8-coset-enumeration"]
VerificationTest[memberEq[session[RadicalDenest3`Private`surdSystem[{6, 35, 77, 330}, <|1 -> 118, 55 -> 14, 210 -> 2, 462 -> 2|>]], Sqrt[6] + Sqrt[35] + Sqrt[77]], True, TestID -> "C-R8-coset-coefficient-solver"]
VerificationTest[memberEq[session[RadicalDenest3`Private`surdRelation[{6, 35, 77, 330}, 118 + 2 Sqrt[210] + 14 Sqrt[55] + 2 Sqrt[462]]], Sqrt[6] + Sqrt[35] + Sqrt[77]], True, TestID -> "C-R8-coset-integer-relation"]
VerificationTest[RadicalDenest3`Private`radicalNodes[AlgebraicNumber[Root[#^5 + Sqrt[2] # + 1 &, 1], {1, 1}]], 0, TestID -> "C-R8-opaque-node-count"]
VerificationTest[eq[RadicalDenest3`RationalizeDenominator[1/(2 + I)], 1/(2 + I)], True, TestID -> "C-R8-gaussian-denominator"]
VerificationTest[{d[1.0 + symbolic] === 1.0 + symbolic, d[{1.0, Sqrt[5 + 2 Sqrt[6]]}] === {1.0, Sqrt[5 + 2 Sqrt[6]]}, d[f[Sqrt[5 + 2 Sqrt[6]]]] === f[Sqrt[5 + 2 Sqrt[6]]]}, {True, True, True}, TestID -> "C-R8-inexact-and-unknown-heads-untouched"]
VerificationTest[FailureQ /@ {d[Sqrt[3 + 2 Sqrt[2]], "MultiplierCap" -> Infinity], d[Sqrt[3 + 2 Sqrt[2]], "MaxOddIndex" -> 0], d[Sqrt[3 + 2 Sqrt[2]], "MaxCosets" -> -1], d[Sqrt[3 + 2 Sqrt[2]], "DiscriminantBatchCap" -> 1/2]}, {True, True, True, True}, TestID -> "C-R8-new-options-validated"]
VerificationTest[Module[{r = RadicalDenest3`DenestReport[Sqrt[3 + 2 Sqrt[2]], "MaxTraceEntries" -> 0]}, {StringQ[r["CertificateKind"]], r["Certificates"], r["CertificatesTruncated"], r["CompletenessClaim"]}], {True, {}, True, False}, TestID -> "C-R8-report-scopes"]
VerificationTest[session[Block[{RadicalDenest3`Private`powerProposals = Function[{target, best}, best], RadicalDenest3`Private`genericProposals = Function[{target, best}, best], RadicalDenest3`Private`multiplierSearch = Function[{target, best}, best]}, RadicalDenest3`Private`improveNumber[Sqrt[2 + Sqrt[2]]]; RadicalDenest3`Private`$memo[Sqrt[2 + Sqrt[2]]][[{"Result", "Complete"}]]]], <|"Result" -> Sqrt[2 + Sqrt[2]], "Complete" -> True|>, TestID -> "C-R8-failed-search-cached-with-budget"]

